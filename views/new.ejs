<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <a href="/">Főoldal</a>
    <a href="/termeklista">Terméklista</a>
    <a href="/filter">Szűrő</a>
    <a href="/new">Új felvétele</a>
    <a href="/stats">Statisztikák</a>
    
    <form action="/new" method="POST">
        <label for="name">Név:</label>
        <input type="text" name="name" required>
        <label for="category">Kategória:</label>
        <select name="category" required>
            <option value="">Kategória kiválasztása</option>
            <option value="elektronika">Elektronika</option>
            <option value="ruházat">Ruházat</option>
            <option value="könyv">Könyv</option>
            <option value="játék">Játék</option>
        </select>
        <label for="price">Ár:</label>
        <input type="number" name="price" required>
        <label for="stock">Készlet:</label>
        <input type="number" name="stock" required>
        <button type="submit">Termék hozzáadása</button>
    </form>

    <%if (success) { %>
        <p class="green">Termék sikeresen hozzáadva!</p>
    <% } %>
</body>
</html>