<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <a href="/">Főoldal</a>
    <a href="/termeklista">Terméklista</a>
    <a href="/filter">Szűrő</a>
    <a href="/new">Új felvétele</a>
    <a href="/stats">Statisztikák</a>

    <table>
        <thead>
            <tr>
                <th>Termék neve</th>
                <th>Termék kategóriája</th>
                <th>Termék ára</th>
                <th>Termék raktárkészlete</th>
            </tr>
        </thead>
        <tbody>
            <% for (let i = 0; i < termekek.length; i++) { %>
                <tr <%- termekek[i].stock === 0 ? 'class="piros"' : '' %>>
                    <td><%= termekek[i].name %></td>
                    <td><%= termekek[i].category %></td>
                    <td><%= termekek[i].price %></td>

                    <% if(termekek[i].stock < 5){ %>
                        <td class="piros"><%= termekek[i].stock %></td>
                    <% } else { %>
                        <td><%= termekek[i].stock %></td>
                    <% } %>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>